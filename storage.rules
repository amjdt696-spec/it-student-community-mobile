rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function approved() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "approved";
    }
    match /group/main/{uid}/{fileName} {
      allow read: if approved();
      allow write: if approved() && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|video/.*|audio/.*|application/pdf|text/plain|application/.*)');
    }
  }
}